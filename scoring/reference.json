      "primary_metric": "auc",
      "metrics": {
        "auc": {"higher_is_better": true, "coefficient": 1.0},
        "precision": {"higher_is_better": true, "coefficient": 0.4},
        "recall": {"higher_is_better": true, "coefficient": 0.4}
      },
      "results": {
        "clip_only": {"type": "baseline", "auc": 79.6, "precision": 29.0, "recall": 73.6},
        "echovlm_full": {"type": "proposed", "auc": 86.5, "precision": 34.2, "recall": 86.2}
      }
    }
  }
}
